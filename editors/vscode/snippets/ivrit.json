{
  "מסמך": {
    "prefix": "מסמך",
    "body": [
      "<מסמך שם=\"${1:שם-האתר}\" מזהה=\"ראשי\">",
      "\t<ראש>",
      "\t\t<מטא שם=\"תיאור\" תוכן=\"${2:תיאור הדף}\" />",
      "\t</ראש>",
      "",
      "\t<מאגר>",
      "\t\t<כותרת1>${3:כותרת הדף}</כותרת1>",
      "\t\t<פסקה>$0</פסקה>",
      "\t</מאגר>",
      "</מסמך>"
    ],
    "description": "מעטפת מסמך מלאה"
  },
  "משתנה": {
    "prefix": "משתנה",
    "body": ["משתנה ${1:שם} = ${2:ערך};", "$0"],
    "description": "הצהרת משתנה"
  },
  "משתנה גלם": {
    "prefix": "משתנה גלם",
    "body": ["משתנה ${1:צבע-ראשי}: ${2:#5b3df5};", "$0"],
    "description": "משתנה גלם שנכנס ל-CSS כמשתנה (--שם)"
  },
  "פונקציה": {
    "prefix": "פונקציה",
    "body": ["פונקציה ${1:שם}(${2:פרמטר}) {", "\t$0", "}"],
    "description": "הגדרת פונקציה"
  },
  "רכיב": {
    "prefix": "רכיב",
    "body": [
      "רכיב ${1:שם}(${2:כותרת}) {",
      "\t<${3:כרטיס}>",
      "\t\t$0",
      "\t\t{ילדים}",
      "\t</${3:כרטיס}>",
      "}"
    ],
    "description": "רכיב HTML עם פרמטרים וחריץ"
  },
  "אם": {
    "prefix": "אם",
    "body": ["אם ${1:תנאי} {", "\t$0", "}", "אחרת {", "\t$1", "}"],
    "description": "תנאי עם אחרת"
  },
  "אחרת אם": {
    "prefix": "אחרת אם",
    "body": ["} אחרת אם ${1:תנאי} {", "\t$0", "}"],
    "description": "ענף נוסף לתנאי"
  },
  "לכל": {
    "prefix": "לכל",
    "body": ["לכל ${1:פריט} ב${2:רשימה} {", "\t$0", "}"],
    "description": "מעבר על רשימה"
  },
  "לכל-בטווח": {
    "prefix": "לכל-בטווח",
    "body": ["לכל-בטווח ${1:i} מ-${2:1} עד-${3:10} {", "\t$0", "}"],
    "description": "מעבר על טווח מספרים"
  },
  "כל-עוד": {
    "prefix": "כל-עוד",
    "body": ["כל-עוד ${1:תנאי} {", "\t$0", "}"],
    "description": "לולאת while"
  },
  "סגנון": {
    "prefix": "סגנון",
    "body": ["סגנון ${1:.מחלקה} {", "\t${2:מאפיין}: ${3:ערך};", "\t$0", "}"],
    "description": "בלוק סגנון"
  },
  "מסך": {
    "prefix": "מסך",
    "body": ["מסך ${1|מסך-טלפון,מסך-טבלט,מסך-לילה,מסך-הדפסה|} {", "\t$0", "}"],
    "description": "כללי עיצוב למצב מסך"
  },
  "עמודות": {
    "prefix": "עמודות",
    "body": ["<עמודות>", "\t<עמודה>$1</עמודה>", "\t<עמודה>$2</עמודה>", "</עמודות>", "$0"],
    "description": "רשת שתי עמודות"
  },
  "כרטיס": {
    "prefix": "כרטיס",
    "body": ["<כרטיס>", "\t<כותרת3>$1</כותרת3>", "\t<פסקה>$2</פסקה>", "</כרטיס>", "$0"],
    "description": "כרטיס עם כותרת וטקסט"
  },
  "קוד-בלוק": {
    "prefix": "קוד",
    "body": ["<קוד-בלוק>", "$0", "</קוד-בלוק>"],
    "description": "בלוק קוד מילולי"
  },
  "הערה": {
    "prefix": "הערה",
    "body": ["-- $0"],
    "description": "הערת שורה"
  },
  "קישור": {
    "prefix": "קישור",
    "body": ["<קישור מקור=\"$1\">$0</קישור>"],
    "description": "קישור"
  },
  "טופס": {
    "prefix": "טופס",
    "body": [
      "<טופס פעולה=\"$1\" שיטה=\"POST\">",
      "\t<שדה שם=\"$2\" סוג=\"טקסט\" תווית=\"$3\" />",
      "\t<כפתור-ראשי>שליחה</כפתור-ראשי>",
      "</טופס>",
      "$0"
    ],
    "description": "טופס עם שדה וכפתור"
  }
}
